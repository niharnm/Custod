# ── Custod website — Supabase ────────────────────────────────────────────────
# Public client + auth (browser sign-in, cookie session refresh in middleware).
# Either the new publishable key or the legacy anon key works.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...   # legacy name, alternative to publishable

# Server-side, privileged DB access for the scans store (route handlers only —
# never exposed to the browser). Without these, the API falls back to an
# in-memory dev store and nothing is persisted.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...
# SUPABASE_SERVICE_ROLE_KEY=eyJ...   # legacy name, alternative to the secret key

# Public base URL, used when building share links.
NEXT_PUBLIC_APP_URL=http://localhost:3000
