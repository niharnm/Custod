# ── Custod — Supabase ────────────────────────────────────────────────────────
# Public client + auth (browser sign-in, cookie session refresh in middleware).
# Either the publishable key or the legacy anon key works.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...   # legacy name, alternative to publishable

# Server-side, privileged DB access used by the scans storage layer (route
# handlers only — never exposed to the browser). WITHOUT these the API falls
# back to an in-memory dev store and nothing is persisted.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...
# SUPABASE_SERVICE_ROLE_KEY=eyJ...   # legacy name, alternative to the secret key

# Direct Postgres URL (Supabase → Settings → Database → Connection string).
# Only needed to run scripts/apply-schema.mjs to create the tables.
# POSTGRES_URL_NON_POOLING=postgres://postgres:...@db.your-project-id.supabase.co:5432/postgres

# Public base URL, used when building share links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Custod — AI wording ──────────────────────────────────────────────────────
# The scan verdict (score, status, risk breakdown, reset plan) is computed by a
# deterministic rules engine. A model only layers a plain-language *explanation*
# on top — it never changes the numbers. Provider precedence: Groq → OpenAI →
# Gemini.
#
# A shared Groq default key is BUNDLED with Custod (src/lib/ai/index.ts and the
# macOS AIConfig), so AI reasoning works out of the box — you do NOT need your
# own key. Set GROQ_API_KEY below only to OVERRIDE / rotate the bundled default.
GROQ_API_KEY=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
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=AIza...

# ── Other Custod clients (config lives in-app, NOT in this .env) ──────────────
# Chrome extension : extension/config.js → WEB_APP_URL  (the "VITE_WEB_APP_URL"
#                    equivalent for this unbundled MV3 extension); Supabase
#                    config in extension/supabase.js. Same Supabase project.
# macOS app        : macos/.../CustodConfig.swift — override CUSTOD_WEB_URL /
#                    CUSTOD_SUPABASE_URL / CUSTOD_SUPABASE_ANON_KEY via env.
# iOS app          : ios/.../CustodConfig.swift   — CUSTOD_SUPABASE_URL /
#                    CUSTOD_SUPABASE_ANON_KEY. All clients hit the SAME backend.
#
# Vercel deployment: set NEXT_PUBLIC_APP_URL, NEXT_PUBLIC_SUPABASE_URL,
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY, SUPABASE_URL, SUPABASE_SECRET_KEY (and
# optionally an AI key) in Project → Settings → Environment Variables.
