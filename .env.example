NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: AI reasoning layer. When set, Custod uses an LLM to explain *why* a
# session looks strained (weighing tab load, mood, time pressure, distraction
# mix) instead of only restating the deterministic score. Server-side only.
# Groq is preferred; OpenAI / Gemini are fallbacks if you set those instead.
GROQ_API_KEY=gsk_...
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=...
